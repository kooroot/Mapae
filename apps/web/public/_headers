/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://sepolia-rpc.giwa.io https://sepolia-explorer.giwa.io; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
