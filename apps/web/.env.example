# 공개 배포용 값만 들어갑니다. Vite 는 VITE_ 접두 변수를 번들에 그대로 인라인하므로
# 여기에 넣은 값은 방문자 전원에게 공개됩니다. 사설 RPC(경로에 API 키가 들어가는 형태)
# 는 절대 넣지 마세요 — vite.config.ts 가 빌드를 거부합니다.

# 비워두면 공개 GIWA 엔드포인트를 씁니다.
VITE_RPC_URL=https://sepolia-rpc.giwa.io

# 로컬에서 회수 제출기를 함께 띄울 때만. loopback 이외의 값은 빌드가 거부합니다.
# 배포본에는 설정하지 않습니다.
# VITE_REVOCATION_SUBMITTER_URL=http://127.0.0.1:8082

# 계정 부트스트랩(가스 대납 배포). 비워두면 온보딩이 그 단계를 건너뛰고, 사용자는
# 직접 배포된 계정을 가지고 있어야 합니다. **경로 없는 오리진**을 넣습니다 —
# 클라이언트가 /bootstrap 을 붙이므로 여기에 경로까지 적으면 404 가 됩니다.
# facilitator.mapae.io 또는 loopback 이외의 호스트는 빌드가 거부합니다.
# VITE_BOOTSTRAP_URL=https://facilitator.mapae.io

# 하나의 코드베이스를 두 개의 public surface로 빌드합니다.
# 로컬은 combined: `/` 랜딩, `/app` Studio.
# mapae.io 배포는 landing, app.mapae.io 배포는 app을 사용합니다.
VITE_SITE_SURFACE=combined
VITE_LANDING_URL=https://mapae.io
VITE_APP_URL=https://app.mapae.io
VITE_DOCS_URL=https://gitbook.mapae.io
