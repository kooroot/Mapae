{
  "name": "@mapae/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:landing": "CLOUDFLARE_ENV=landing VITE_SITE_SURFACE=landing vite build",
    "build:app": "CLOUDFLARE_ENV=app VITE_SITE_SURFACE=app vite build",
    "preview": "vite preview",
    "deploy:landing": "bun run build:landing && wrangler deploy --env landing",
    "deploy:app": "bun run build:app && wrangler deploy --env app"
  },
