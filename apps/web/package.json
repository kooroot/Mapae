    "@mapae/delegation": "workspace:*",
    "@mapae/shared": "workspace:*",
    "@metamask/smart-accounts-kit": "1.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "lucide-react": "^1.27.0",
    "pretendard": "1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.185.1",
    "viem": "^2.55.8",
    "wagmi": "^3.7.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
