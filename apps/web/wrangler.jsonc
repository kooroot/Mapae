{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mapae",
    "compatibility_date": "2025-09-02",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": "src/server.ts",
    "observability": {
        "enabled": true
    },
    "workers_dev": false,
    "preview_urls": false,
    "env": {
        "landing": {
            "name": "mapae",
            "workers_dev": false,
            "preview_urls": false,
            "routes": [
                {
                    "pattern": "mapae.io",
                    "custom_domain": true
                }
            ],
            "d1_databases": [
                {
                    "binding": "ARCADE_DB",
                    "database_name": "mapae-arcade-profiles",
                    "database_id": "4b131cc7-83a4-4980-b53e-1460f7706fc0"
                }
            ]
        },
        "app": {
            "name": "mapae-app",
            "workers_dev": false,
            "preview_urls": false,
            "routes": [
                {
                    "pattern": "app.mapae.io",
                    "custom_domain": true
                }
            ],
            "d1_databases": [
                {
                    "binding": "ARCADE_DB",
                    "database_name": "mapae-arcade-profiles",
                    "database_id": "4b131cc7-83a4-4980-b53e-1460f7706fc0"
                }
            ]
        }
    },
    "d1_databases": [
        {
            "binding": "ARCADE_DB",
            "database_name": "mapae-arcade-profiles",
            "database_id": "4b131cc7-83a4-4980-b53e-1460f7706fc0"
        }
    ]
}
