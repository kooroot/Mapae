SELLER_URL=http://127.0.0.1:3001
FACILITATOR_URL=http://127.0.0.1:8081
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
DELEGATION_DEPLOYMENT_PATH=../../deployments/giwa-sepolia.framework.json
DELEGATION_MANIFEST_PATH=../../deployments/giwa-sepolia.framework-manifest.json
FRAMEWORK_ADMIN_ADDRESS=0x3333333333333333333333333333333333333333
PARENT_PERMISSION_CONTEXT_PATH=./open-agent.permission.json

# Runtime spend limits. Each one is off when the variable is unset — the final bound is
# the on-chain caveat either way. An invalid value fails boot rather than running unlimited.
# AGENT_MAX_PAYMENT_MUSDC=1.00
# AGENT_SESSION_BUDGET_MUSDC=5.00
# AGENT_ALLOWED_PAY_TO=0x...,0x...

# Keep the real session key only in ignored .env:
# AGENT_PRIVATE_KEY=0x...
