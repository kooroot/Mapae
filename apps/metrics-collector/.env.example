# apps/metrics-collector — copy to .env (gitignored, chmod 600). Bun loads .env from the
# working directory, which is why both launchd plists set WorkingDirectory here and carry
# no secrets themselves.

# The Worker's ingest endpoint and the bearer it checks (same value as the Worker's
# INGEST_TOKEN secret; 32-256 printable characters). HTTPS only, or loopback for wrangler dev.
OPS_INGEST_URL=https://mapae-ops-monitor.<account>.workers.dev/ingest
INGEST_TOKEN=

# The services' stores. Opened READ-ONLY; the collector never writes to them.
SELLER_STORE_PATH=/absolute/path/to/seller.sqlite
FACILITATOR_STORE_PATH=/absolute/path/to/facilitator.sqlite

# The collector's own state: chain cursor + decoded events.
METRICS_DB_PATH=/absolute/path/to/metrics.sqlite

# Optional. A JSON array of cohort addresses, kept outside the repository
# (mapae-internal-docs). Absent means an empty cohort, reported as "missing".
# METRICS_COHORT_FILE=/absolute/path/to/cohort.json

# Optional. Each daily snapshot is also written here as <KST day>.json.
# METRICS_SNAPSHOT_DIR=/absolute/path/to/snapshots

# The daily indexer's RPC. Unset means the public endpoint. A private provider URL
# carries its API key in the PATH, so it is a secret even though it does not look like
# one: never in a VITE_ variable, never as a shell argument, never pasted into chat.
# The hourly balance reads always use the public endpoint.
# GIWA_SEPOLIA_RPC_URL=
# The most blocks one eth_getLogs call may cover on that endpoint. The default, 10000, is
# the public endpoint's limit. A provider plan can allow fewer (1000 was measured on one),
# and a larger value than the endpoint allows fails the daily run on its first call.
# METRICS_LOG_SPAN=10000

# Public addresses only, never keys. The same names every funded service already reads.
FACILITATOR_SIGNER_ADDRESS=
# BOOTSTRAP_ADDRESS=
# REVOCATION_RELAYER_ADDRESS=
# REVOCATION_SPONSOR_ADDRESS=

# Optional extra internal addresses (demo payers, team wallets), comma-separated.
# METRICS_INTERNAL_ADDRESSES=0x...,0x...

# Must match the facilitator's own RELAYER_DAILY_WEI when that is overridden there.
# RELAYER_DAILY_WEI=500000000000000
# Funded-wallet floor for the hourly balance check (default 0.005 ETH).
# WALLET_MIN_WEI=5000000000000000
