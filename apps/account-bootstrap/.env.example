# Sponsored account bootstrap — copy to .env and fill in. NEVER commit the real file.
#
# This service spends its own ETH on behalf of unauthenticated callers. Everything below
# exists to bound that. Read apps/account-bootstrap/index.ts before changing a default.

# --- Kill switch -------------------------------------------------------------------
# Off by default. A deployment that forgets a variable must not start spending.
BOOTSTRAP_ENABLED=false

# --- Approval ----------------------------------------------------------------------
# Required whenever BOOTSTRAP_ENABLED=true. Pinned to the framework composition, so a
# framework redeploy invalidates it rather than silently inheriting the approval.
# The exact expected value is printed in the error when it does not match.
BOOTSTRAP_APPROVAL=

# --- Sponsor key -------------------------------------------------------------------
# A DEDICATED EOA. Must differ from the facilitator relayer and the framework deployer:
# both are single-consumer nonce spaces, and a sponsor driven at internet request rate
# would stall settlement rather than merely cost ETH. The service refuses to boot if
# BOOTSTRAP_ADDRESS equals RELAYER_ADDRESS or DEPLOYER_ADDRESS.
#
# The balance of this wallet is the maximum a griefing run can cost.
BOOTSTRAP_PRIVATE_KEY=
BOOTSTRAP_ADDRESS=

# Optional, only so the boot-time separation check can run. Public addresses.
RELAYER_ADDRESS=
DEPLOYER_ADDRESS=

# --- Chain -------------------------------------------------------------------------
# Treat a keyed RPC URL as a credential: it is a secret even though it does not look
# like one. Never pass it as a shell argument, never log it whole.
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
DELEGATION_DEPLOYMENT_PATH=../../deployments/giwa-sepolia.framework.json

# --- Bind --------------------------------------------------------------------------
# Loopback only. The Cloudflare Tunnel is the sole public path, and it exposes
# POST /bootstrap alone — /health reports the sponsor balance and stays private.
HOST=127.0.0.1
PORT=8083

# --- Origins -----------------------------------------------------------------------
# Comma-separated. HTTPS required unless loopback. '*' is refused.
# This is not access control — a non-browser client omits Origin entirely. Authority
# comes from the signature in the body; the budget and rate limit bound the spend.
BOOTSTRAP_ALLOWED_ORIGINS=https://app.mapae.io,http://127.0.0.1:5173

# --- Ceilings ----------------------------------------------------------------------
# Deploy measured at 189,374 gas; gas price measured at ~1,000,266 wei (2026-08-03).
MAX_BOOTSTRAP_GAS=250000
MAX_BOOTSTRAP_MINT_GAS=100000
MAX_BOOTSTRAP_FEE_PER_GAS=50000000
# Set explicitly: viem defaults the tip to 1 gwei, which is 20x the cap above, and the
# node then refuses every broadcast with "tip cannot be higher than the fee cap".
BOOTSTRAP_PRIORITY_FEE_WEI=1000000
BOOTSTRAP_RECEIPT_TIMEOUT_MS=60000

# The only bound that is a real guarantee. Per-account idempotency is not a budget:
# a counterfactual address is CREATE2(owner) and owners are free to mint offline.
# 500_000_000_000_000 wei = 0.0005 ETH ≈ 2,500 deploys/day at the measured price.
BOOTSTRAP_DAILY_WEI=500000000000000
# A floor the sponsor is never spent below. The service refuses when the balance is under
# this PLUS the reservation for the request in hand — the node's own upfront rule is
# `balance >= gasLimit * maxFeePerGas`, so checking the floor alone left a band where the
# gate passed and every broadcast was then refused by the node with an opaque 502.
BOOTSTRAP_MIN_BALANCE_WEI=1000000000000
BOOTSTRAP_RATE_PER_HOUR=20

# --- Testnet faucet ----------------------------------------------------------------
# TESTNET ONLY. MockUSDC.mint is permissionless, so this grants no authority the caller
# lacks — it only spends our gas. Hard-pinned to chain 91342 in code. On mainnet the
# user funds the account with real value, which works at the counterfactual address
# before deployment because an ERC-20 balance lives in the token contract's storage.
BOOTSTRAP_FAUCET_ENABLED=false
# Base units, 6 decimals. 3_000_000 = 3.00 mUSDC = one open-agent period cap.
BOOTSTRAP_FAUCET_AMOUNT_BASE=3000000
#
# A mint that fails never fails the deploy — the deploy is the expensive, irreversible half.
# A retry then tops the account up if and only if its balance is exactly zero, because
# otherwise a failed mint would be permanent: every later request takes the already-deployed
# branch, and the payer holds no ETH by design so it cannot fund itself.
