HOST=127.0.0.1
PORT=8081
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
DELEGATION_DEPLOYMENT_PATH=../../deployments/giwa-sepolia.framework.json
DELEGATION_MANIFEST_PATH=../../deployments/giwa-sepolia.framework-manifest.json
FRAMEWORK_ADMIN_ADDRESS=0x3333333333333333333333333333333333333333
# The settlement signer's one global name across every service (the deprecated
# RELAYER_* spelling still boots, with a warning, until this .env is renamed).
FACILITATOR_SIGNER_ADDRESS=0x6666666666666666666666666666666666666666

# Keep the real value only in ignored .env:
# FACILITATOR_SIGNER_PRIVATE_KEY=0x...

# Defense-in-depth caps; D3 caveats are the authoritative spending control.
MAX_SETTLEMENT_AMOUNT=10.00
MAX_REDEMPTION_GAS=1500000

# Innermost of four stacked timeouts. Raising it requires raising the seller's
# SETTLE_TIMEOUT_MS and IDLE_TIMEOUT_SECONDS and the agent's REQUEST_TIMEOUT_MS with it —
# each layer must out-wait the one inside it, or an outer hop hangs up on a settlement
# that is still running and the caller is told a mined payment failed.
SETTLEMENT_RECEIPT_TIMEOUT_MS=25000
