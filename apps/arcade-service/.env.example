# All credentials remain in this local server process. No VITE_ credential variables.
ARCADE_MODEL_PROVIDER=disabled
# To use an already installed local Ollama model:
# ARCADE_MODEL_PROVIDER=ollama
# ARCADE_MODEL=your-installed-model
# ARCADE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
ARCADE_MODEL_MAX_CALLS=60
ARCADE_MODEL_TIMEOUT_MS=45000

# Official OpenAI is opt-in and may incur cost. Enable only with the user's approval.
# ARCADE_MODEL_PROVIDER=openai
# ARCADE_MODEL=gpt-4.1-mini
# ARCADE_ALLOW_PAID_MODEL=true
# OPENAI_API_KEY=server-only-value

# disabled | simulation | fork. There is deliberately no live GIWA mode.
ARCADE_PAYMENT_MODE=disabled
# ARCADE_PAYMENT_MODE=simulation
# Store path prefix; each mode has separate admission and financial databases.
ARCADE_STORE_PREFIX=./data/arcade

# A running, explicitly configured local Anvil fork only. Never use a live RPC here.
# ARCADE_PAYMENT_MODE=fork
# ARCADE_ALLOW_LOCAL_FORK=true
# GIWA_SEPOLIA_RPC_URL=http://127.0.0.1:8545
# ARCADE_PAY_TO=nonzero-public-receiving-address
# FRAMEWORK_ADMIN_ADDRESS=framework-owner-on-the-fork
# DELEGATION_DEPLOYMENT_PATH=../../deployments/giwa-sepolia.framework.json
# DELEGATION_MANIFEST_PATH=../../deployments/giwa-sepolia.framework-manifest.json
# PARENT_PERMISSION_CONTEXT_PATH=path-to-owner-signed-parent.permission.json
# AGENT_PRIVATE_KEY=server-only-session-key-matching-the-parent
# AGENT_SESSION_BUDGET_MUSDC=0.1
# Do NOT set FACILITATOR_URL. The fork mode constructs its own Anvil-only facilitator.
