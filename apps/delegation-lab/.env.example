# Public deployment identities. These are addresses, never private keys.
CASE_1_OWNER_ADDRESS=0x1111111111111111111111111111111111111111
CASE_2_VENDOR_ADDRESS=0x2222222222222222222222222222222222222222
FRAMEWORK_ADMIN_ADDRESS=0x3333333333333333333333333333333333333333
DEPLOYER_ADDRESS=0x4444444444444444444444444444444444444444
RELAYER_ADDRESS=0x6666666666666666666666666666666666666666

# Bootstrap evidence is never accepted by D4 applications.
DELEGATION_BOOTSTRAP_PATH=../../deployments/giwa-sepolia.framework.bootstrap.json

# Active artifact is created only after the Framework admin accepts ownership.
DELEGATION_DEPLOYMENT_PATH=../../deployments/giwa-sepolia.framework.json
DELEGATION_MANIFEST_PATH=../../deployments/giwa-sepolia.framework-manifest.json

# Public transaction hash supplied after the Framework-admin wallet submits
# acceptOwnership(). The finalizer never reads an admin private key.
# FRAMEWORK_OWNERSHIP_ACCEPTANCE_TX=0x...

# Deployment requires BOTH `--broadcast` and the exact approval phrase documented
# by `bun run deploy-framework.ts`. The legacy deployment route uses
# DEPLOYER_PRIVATE_KEY, never RELAYER_PRIVATE_KEY. Do not put either key here.

# Upstream GIWA endpoint. The public one rate-limits, and Anvil *panics* on a 429 during
# block execution — every later case then reports "Unable to connect" and reads like a
# local network fault. A private endpoint is the fix.
#
# A private endpoint authenticates with an API key *in the URL path*, which makes the
# whole URL a secret. parseNodeRpcUrl only rejects credentials in userinfo, so nothing
# will warn you. Therefore:
#   - put the real value only in this directory's .env (gitignored) — never in this
#     .example, never in a doc, never in a committed script, never as a shell argument
#   - server-side variables ONLY. It must never reach a VITE_ variable: Vite inlines
#     those into apps/console's built bundle and publishes them to every visitor.
#     apps/console/src/config.ts refuses a non-public, non-loopback URL for that reason.
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_FORK_SOURCE_RPC_URL=https://sepolia-rpc.giwa.io

# Anvil's upstream request budget for a fork run. 50 is sized for the public endpoint;
# raise it only when the fork source points at a private one.
SUITE_CUPS=50
