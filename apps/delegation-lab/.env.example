# Public deployment identities. These are addresses, never private keys.
ACCOUNT_OWNER_ADDRESS=0x1111111111111111111111111111111111111111
FRAMEWORK_ADMIN_ADDRESS=0x3333333333333333333333333333333333333333
FIXED_VENDOR_ADDRESS=0x2222222222222222222222222222222222222222

# Public artifact created only after an explicitly approved GIWA deployment.
DELEGATION_DEPLOYMENT_PATH=../../deployments/giwa-sepolia.framework.json

# Deployment requires BOTH `--broadcast` and the exact approval phrase documented
# by `bun run deploy-framework.ts`. Do not put RELAYER_PRIVATE_KEY in this example.
