HOST=127.0.0.1
PORT=3001
FACILITATOR_URL=http://127.0.0.1:8081

# The origin buyers reach this shop at — every 402 and every manifest names item URLs
# on it. Required when HOST is not loopback; a loopback server defaults to itself.
# BASE_URL=https://seller.mapae.io

# Where the shops, items and orders live (bun:sqlite via @mapae/store). The directory is
# created on boot; `:memory:` keeps nothing across a restart. The seed writes here too.
STORE_PATH=./data/seller.sqlite

# Public receiving address the seed gives the demo shops; this is not a private key.
# `bun run seed` reads SEED_PAY_TO first and falls back to PAY_TO.
PAY_TO=0x2222222222222222222222222222222222222222

# Bun's idle timeout in seconds. Must exceed the paywall's 35 s settle call; max 255.
IDLE_TIMEOUT_SECONDS=45

# Unset: GET /metrics answers 503 metrics_disabled. Set (16+ characters): the endpoint
# answers `Authorization: Bearer <token>` with the all-time and last-24h order counts.
# METRICS_TOKEN=

# The facilitator origin buyers are told about in the manifest and /health. Settlement
# still goes over FACILITATOR_URL (loopback on the mini); this is what an agent reading
# the manifest will call. Required when BASE_URL is not loopback — the server refuses to
# boot rather than point buyers at their own machine.
# PUBLIC_FACILITATOR_URL=https://facilitator.mapae.io

# Shared only with the two web Workers; receipt lookup scope, never client VITE_* env.
# ARCADE_RECEIPT_TOKEN=

# Durable rule-based arcade outings, running inside this seller process. Default off.
# Reuse ARCADE_RECEIPT_TOKEN from the authenticated web Workers. Never expose the key
# through VITE_* or reuse a funded service wallet. This signer needs no GIWA ETH.
ARCADE_OUTINGS_ENABLED=false
# ARCADE_AGENT_PRIVATE_KEY=
# Required when outings are enabled after the Guardian rollout. Chain 91342 only.
# ARCADE_GUARDIAN_ADDRESS=
# Separate unfunded result-attestation signer; must match collection.resultSigner().
# Never reuse ARCADE_AGENT_PRIVATE_KEY, deployment, admin or service-funded keys.
# ARCADE_RESULT_PRIVATE_KEY=
# Public role addresses allow startup to catch accidental key reuse.
# GUARDIAN_DEPLOYER_ADDRESS=
# GUARDIAN_ADMIN_ADDRESS=

# 공유 카드 레이어 아트(share/*.png 36장 + wardrobe/fit.json)가 있는 디렉터리. 기본값은 저장소의 apps/web/public/arcade — 에셋 저장소의 arcade/ 복사본을 그 자리에 둔다.
# ARCADE_ART_DIR=../web/public/arcade
