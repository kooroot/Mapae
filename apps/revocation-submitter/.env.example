HOST=127.0.0.1
PORT=8082
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
DELEGATION_DEPLOYMENT_PATH=../../deployments/giwa-sepolia.framework.json

# The one account this submitter will act for. Anything else is refused before a read.
# Leaving this UNSET selects the sponsored public mode below — that absence is the mode
# switch, which is why sponsored mode refuses to boot without its own kill switch and
# approval phrase: deleting one variable must never silently open the service.
PAYER_ACCOUNT_ADDRESS=0x1111111111111111111111111111111111111111
RELAYER_ADDRESS=0x6666666666666666666666666666666666666666

# Keep the real value only in ignored .env:
# RELAYER_PRIVATE_KEY=0x...

# Defaults are the exact values buildRevocationUserOperation emits. Raising one is a
# statement that a differently-shaped operation is expected — not routine headroom.
MAX_CALL_GAS_LIMIT=300000
MAX_VERIFICATION_GAS_LIMIT=300000
MAX_PRE_VERIFICATION_GAS=100000
MAX_FEE_PER_GAS=1000000000

REVOCATION_RECEIPT_TIMEOUT_MS=60000

# Browser origins allowed to reach POST /revoke. The console runs on a different port, so
# every revoke is cross-origin and preflighted; without an answer the button silently does
# nothing. Loopback only, never '*' — this service has no application authentication and
# fronts a funded relayer key. Defaults cover `vite` (5173) and `vite preview` (4173).
REVOCATION_CONSOLE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# ── Sponsored public mode (PAYER_ACCOUNT_ADDRESS unset) ─────────────────────────────────
# Any account may revoke its own grant; the sponsor arms the EntryPoint deposit at revoke
# time so the owner's wallet never needs GIWA ETH. Every response body is a closed enum.
#
# The kill switch defaults to off, and the approval phrase is pinned to the framework
# composition — print the expected value by booting once without it; a framework redeploy
# invalidates it on purpose.
# REVOCATION_SPONSOR_ENABLED=true
# REVOCATION_SPONSOR_APPROVAL=sponsored-revocation-chain-91342-<compositionId>
#
# A dedicated EOA. Must differ from the relayer (this same process broadcasts handleOps
# with it) and from DEPLOYER_ADDRESS / BOOTSTRAP_ADDRESS if set — a shared nonce space
# stalls the other consumer. Keep the real key only in ignored .env.
# REVOCATION_SPONSOR_ADDRESS=0x7777777777777777777777777777777777777777
# REVOCATION_SPONSOR_PRIVATE_KEY=0x...
#
# Neither of these keys may equal the sponsor's. The check only fires when the variable
# is present, so set them here if this host also runs those services.
# DEPLOYER_ADDRESS=0x8888888888888888888888888888888888888888
# BOOTSTRAP_ADDRESS=0x9999999999999999999999999999999999999999
#
# In sponsored mode MAX_FEE_PER_GAS and MIN_FEE_PER_GAS both default to 10000000
# (0.01 gwei) — the SPONSORED_REVOCATION_GAS profile, as a floor as well as a ceiling.
#
# The ceiling bounds the *gift*: the prefund refunds its unused part into the requester's
# own deposit, where their owner can withdraw it, so 0.01 gwei caps that at 0.000007 ETH
# per request. Raising it back to 1 gwei for a public deployment turns the endpoint into a
# 0.0007 ETH-per-request faucet.
#
# The floor bounds the *relayer's loss*. The EntryPoint reimburses at
# min(maxFeePerGas, tip + baseFee) of the signed operation while the relayer's own
# transaction costs baseFee + tip — and on GIWA those differ by three orders of magnitude
# (measured: base fee 267 wei, suggested tip 1,000,000 wei). Without a floor, an operation
# signed just above the base fee passes every other check and reimburses ~1/3700 of what
# the relayer paid; its prefund is proportionally tiny, so the daily budget barely counts
# it. Lowering this is lowering the price of that.
# MIN_FEE_PER_GAS=10000000
#
# 0.0007 ETH/day ≈ 70 sponsored revocations at the worst case. Sized separately from the
# bootstrap budget: one revocation deposit costs more than ten account deploys.
#
# The rate is sized against that budget rather than picked for feel: one request reserves
# ~1e13 wei, so 70/day is the budget, and 2/hour keeps a single IP (48/day) inside it. At
# 10/hour one IP could exhaust the day in seven hours and leave every other owner with
# `budget_exhausted` — the kill switch unavailable, which is the loss that matters.
# REVOCATION_DAILY_WEI=700000000000000
# REVOCATION_RATE_PER_HOUR=2
# REVOCATION_MIN_SPONSOR_BALANCE_WEI=1000000000000
# REVOCATION_DEPOSIT_GAS=60000
# REVOCATION_SPONSOR_FEE_PER_GAS=50000000
# REVOCATION_SPONSOR_PRIORITY_FEE_WEI=1000000
#
# The tip the relayer offers on handleOps, clamped per broadcast to the operation's own
# maxFeePerGas. Stated because viem's default is 1 gwei, which exceeds the sponsored fee
# ceiling outright and makes the node refuse every broadcast.
# RELAYER_PRIORITY_FEE_WEI=1000000
#
# Public browser origins for the sponsored mode (replaces REVOCATION_CONSOLE_ORIGINS,
# which stays loopback-only for the pinned mode). Not access control — a non-browser
# client sends no Origin at all; the budget, rate limit and signature check are the
# defense. Defaults cover app.mapae.io plus the loopback dev ports.
# REVOCATION_ALLOWED_ORIGINS=https://app.mapae.io,http://127.0.0.1:5173,http://localhost:5173
