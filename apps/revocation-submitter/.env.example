HOST=127.0.0.1
PORT=8082
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
DELEGATION_DEPLOYMENT_PATH=../../deployments/giwa-sepolia.framework.json

# The one account this submitter will act for. Anything else is refused before a read.
PAYER_ACCOUNT_ADDRESS=0x1111111111111111111111111111111111111111
RELAYER_ADDRESS=0x6666666666666666666666666666666666666666

# Keep the real value only in ignored .env:
# RELAYER_PRIVATE_KEY=0x...

# Defaults are the exact values buildRevocationUserOperation emits. Raising one is a
# statement that a differently-shaped operation is expected — not routine headroom.
MAX_CALL_GAS_LIMIT=300000
MAX_VERIFICATION_GAS_LIMIT=300000
MAX_PRE_VERIFICATION_GAS=100000
MAX_FEE_PER_GAS=1000000000

REVOCATION_RECEIPT_TIMEOUT_MS=60000

# Browser origins allowed to reach POST /revoke. The console runs on a different port, so
# every revoke is cross-origin and preflighted; without an answer the button silently does
# nothing. Loopback only, never '*' — this service has no application authentication and
# fronts a funded relayer key. Defaults cover `vite` (5173) and `vite preview` (4173).
REVOCATION_CONSOLE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
