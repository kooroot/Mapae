# Vite INLINES every VITE_* value into the built bundle, so everything here is published
# to every visitor. Nothing secret may appear in this file or in apps/console/.env.

# The endpoint the console reads state from. vite.config.ts refuses anything that is not
# the public GIWA RPC or loopback, and fails the build rather than shipping a credential —
# private RPC providers put their API key in the URL path, where the shared
# parseNodeRpcUrl (which only checks userinfo) cannot see it.
VITE_RPC_URL=https://sepolia-rpc.giwa.io

# The signed root permission this console inspects. A public artifact: it is what the
# agent already presents to the seller on every payment.
VITE_PERMISSION_CONTEXT=0x

# Where a signed revocation is POSTed. Unset means the revoke button stays disabled —
# collecting a wallet signature with nowhere to send it is worse than no button, because
# the signature is a bearer authorization to disable the permission.
#
# Loopback only, enforced at build time. Not a secret; the restriction is about where
# authority may travel. apps/revocation-submitter has no application authentication and
# holds a funded relayer key.
VITE_REVOCATION_SUBMITTER_URL=http://127.0.0.1:8082

# eth_getLogs window for the receipts screen. GIWA rejects spans wider than 100k blocks.
VITE_RECEIPT_LOOKBACK_BLOCKS=50000
