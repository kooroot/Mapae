# Cloudflare Workers local state and build output (apps/web)
.wrangler/
.output/

# Cloudflare Workers local secrets. `.dev.vars` is where wrangler expects a real
# secret in development, so it must never be commit-eligible.
.dev.vars
.dev.vars.*

# Run artifacts written into the tree by the GIWA demo scripts
*.evidence.json

# `@mapae/store` ledgers (bun:sqlite) — a service's persisted state lives beside it and
# must never be commit-eligible. WAL leaves the two sidecar files while a store is open.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# dev-tool artifacts
.openai/
.claude/

# Generated documentation site — rebuilt by `bun run build:docs`.
apps/docs/dist/
