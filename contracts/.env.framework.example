# Copy only the variables you need into contracts/.env, then chmod 600.
# Never commit a populated .env or pass a private key on the command line.

# GIWA Sepolia gas-paying Framework deployer. It is deliberately distinct from
# the D4 settlement relayer.
DEPLOYER_ADDRESS=0x4444444444444444444444444444444444444444
DEPLOYER_PRIVATE_KEY=0x
# Existing installations may keep the same deployer key under PRIVATE_KEY.
# The script accepts that legacy alias only when DEPLOYER_PRIVATE_KEY is absent
# and still requires the derived address to equal DEPLOYER_ADDRESS.

# Public role addresses.
FRAMEWORK_ADMIN_ADDRESS=0x3333333333333333333333333333333333333333
CASE_1_OWNER_ADDRESS=0x1111111111111111111111111111111111111111
CASE_2_VENDOR_ADDRESS=0x2222222222222222222222222222222222222222
RELAYER_ADDRESS=0x6666666666666666666666666666666666666666
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io

# Exact double-confirmation required by DeployDelegationFramework.s.sol.
GIWA_DEPLOYMENT_APPROVAL=reviewed-chain-91342-mapae-sak-1.7.0-d90569fa-df-d0ebab53-e297f795

# Local generated input and public address output.
FRAMEWORK_ARTIFACT_PATH=./generated/framework-artifacts.json
FRAMEWORK_FORGE_ADDRESS_PATH=../deployments/giwa-sepolia.framework-forge-addresses.json
DELEGATION_BOOTSTRAP_PATH=../deployments/giwa-sepolia.framework.bootstrap.json
DELEGATION_DEPLOYMENT_PATH=../deployments/giwa-sepolia.framework.json

# Set after the read-only importer has produced DELEGATION_BOOTSTRAP_PATH.
# The manager address is read from verified bootstrap evidence, not typed by hand.
FRAMEWORK_ADMIN_PRIVATE_KEY=0x
GIWA_OWNERSHIP_ACCEPTANCE_APPROVAL=reviewed-ownership-acceptance-chain-91342-mapae-sak-1.7.0-d90569fa-df-d0ebab53-e297f795

# Set only after the Framework is active and the owner account is ready to deploy.
GIWA_ACCOUNT_DEPLOYMENT_APPROVAL=reviewed-owner-account-chain-91342-mapae-sak-1.7.0-d90569fa-df-d0ebab53-e297f795
OWNER_ACCOUNT_FORGE_PATH=../deployments/giwa-sepolia.owner-account.json
